# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Public base URL of the app (used for absolute links/redirects if needed)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Prisma / SQLite database. The path is resolved relative to prisma/schema.prisma,
# so this file lives at prisma/dev.db. After setting it, run:
#   npm run db:push && npm run db:seed
DATABASE_URL="file:./dev.db"

# Stripe (OPTIONAL). Leave unset to update plans directly (the demo default).
# When set, paid upgrades go through Stripe Checkout and the webhook applies the plan.
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_WEBHOOK_SECRET=whsec_...        # from `stripe listen`
#   STRIPE_PRICE_PRO=price_...             # Stripe Price ID for the Pro plan
#   STRIPE_PRICE_ENTERPRISE=price_...      # Stripe Price ID for the Enterprise plan
